            <property name="dataSource">examenes</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">nombre_examen</property>
                    <property name="nativeName">titulo</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">correo_usuario</property>
                    <property name="nativeName">correo_usuario</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">nota_final</property>
                    <property name="nativeName">nota</property>
                    <property name="dataType">float</property>
                    <property name="nativeDataType">8</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">enunciado</property>
                    <property name="nativeName">enunciado</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">correcta</property>
                    <property name="nativeName">correcta</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">respuesta_marcada</property>
                    <property name="nativeName">respuesta_marcada</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">estado</property>
                    <property name="nativeName">estado</property>
                    <property name="dataType">string</property>
                    <property name="nativeDataType">12</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
    ex.titulo AS nombre_examen,
    ev.correo_usuario,
    ev.nota AS nota_final,
    p.enunciado,
    p.correcta,
    ru.respuesta_marcada,
    CASE 
        WHEN p.correcta = ru.respuesta_marcada THEN 'ACIERTO'
        ELSE 'FALLO'
    END AS estado
FROM 
    evaluaciones ev
JOIN 
    examenes ex ON ev.id_examen = ex.id
JOIN 
    respuestas_usuario ru ON ev.id = ru.id_evaluacion
JOIN 
    preguntas p ON ru.id_pregunta = p.id
WHERE 
    ev.id = ?]]></xml-property>
        </oda-data-set>
    </data-sets>
