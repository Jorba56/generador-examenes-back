                    <property name="dataType">decimal</property>
                    <property name="nativeDataType">3</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT 
    e.titulo AS examen_titulo,
    ev.correo_usuario AS correo_alumno,
    ev.fecha AS fecha_examen,
    CAST(IFNULL(ev.nota, 0) AS DECIMAL(5,2)) AS nota_final,
    CAST(IFNULL(ev.nota * 10, 0) AS DECIMAL(5,2)) AS porcentaje_aciertos,
    CAST(IFNULL(100 - (ev.nota * 10), 0) AS DECIMAL(5,2)) AS porcentaje_fallos
FROM evaluaciones ev
INNER JOIN examenes e ON ev.id_examen = e.id
ORDER BY ev.fecha DESC;]]></xml-property>
